+.guide-madhab summary { cursor: pointer; font-weight: 800; font-size: 0.98rem; color: #065f46; list-style-position: inside; }
+.guide-madhab[dir="rtl"] summary { font-family: 'Tajawal', 'Amiri', sans-serif; }
